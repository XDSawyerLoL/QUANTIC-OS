[Unit]
Description=Quantic local LLM engine (Ollama)
After=local-fs.target quantic-persistence.service
Wants=quantic-persistence.service
ConditionPathExists=/usr/bin/ollama

[Service]
Type=simple
User=ollama
Group=ollama
ExecStartPre=/usr/bin/mkdir -p /var/lib/quantic/models/ollama
ExecStart=/usr/bin/ollama serve
Restart=on-failure
RestartSec=2
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/quantic/models/ollama
Environment=OLLAMA_KEEP_ALIVE=10m
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
ReadWritePaths=/var/lib/quantic

[Install]
WantedBy=multi-user.target
